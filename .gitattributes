# Normalize line endings: store text as LF in the repo, check out native on each OS.
* text=auto eol=lf

# Scripts that must keep LF even on Windows checkouts
*.sh text eol=lf
mvnw text eol=lf

# Windows-only scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
mvnw.cmd text eol=crlf

# Treat these as binary (never normalize or diff as text)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.jar binary
*.woff binary
*.woff2 binary
