# Copy this file to .env and fill in real values: cp .env.example .env
#
# Dev: the defaults below (with a generated JWT_SECRET) are enough.
# Prod: see the "PRODUCTION" section at the bottom — several values MUST change.

# --- Database ---
POSTGRES_DB=ripplechat
POSTGRES_USER=ripplechat
# CHANGE FOR PROD: use a strong, unique password (never ship "change-me").
POSTGRES_PASSWORD=change-me

# Host port for PostgreSQL.
POSTGRES_HOST_PORT=5432

# --- Backend ---
# Backend HTTP port.
SERVER_PORT=8080

# JWT signing secret (HS256, must be >= 32 bytes). Generate e.g.: openssl rand -hex 48
# CHANGE FOR PROD: must be a long random secret, kept out of version control.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
# Token lifetimes (ms). Access tokens are short-lived and renewed via the
# longer-lived, server-stored refresh token. Defaults: 1h access, 7d refresh.
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Browser origins allowed to call the API and open the WebSocket (comma-separated).
# Dev default (when unset) is http://localhost:5173. Never use "*".
APP_ALLOWED_ORIGINS=http://localhost:5173

# Image attachments (optional). When set, message image uploads go to Cloudinary;
# leave unset to disable uploads (the app still runs). Format:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Web Push notifications (optional). Generate a key pair with:
#   npx web-push generate-vapid-keys
# Set both keys to enable browser push; leave unset to disable (the app still
# runs). VAPID_SUBJECT is a contact mailto: or URL.
# VAPID_PUBLIC_KEY=<base64url public key>
# VAPID_PRIVATE_KEY=<base64url private key>
# VAPID_SUBJECT=mailto:you@example.com

# =====================================================================
# PRODUCTION (set these in the prod environment; do not commit real values)
# ---------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=prod      # enables validate + Flyway, disables SQL logging
# POSTGRES_PASSWORD=<strong-unique-password>
# JWT_SECRET=<openssl rand -hex 48>
# APP_ALLOWED_ORIGINS=https://your-real-domain.com
# POSTGRES_DB / POSTGRES_USER / POSTGRES_HOST_PORT / SERVER_PORT as appropriate
# (the datasource URL is built from POSTGRES_* — point it at the prod database)
# Note: on first prod deploy the database should be empty so Flyway can apply
# V1__initial_schema.sql; Hibernate then validates the schema against the entities.
# =====================================================================
