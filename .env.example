# Copy this file to .env and fill in real values: cp .env.example .env
#
# Dev: the defaults below (with a generated JWT_SECRET) are enough.
# Prod: see the "PRODUCTION" section at the bottom — several values MUST change.

# --- Database ---
POSTGRES_DB=ripplechat
POSTGRES_USER=ripplechat
# CHANGE FOR PROD: use a strong, unique password (never ship "change-me").
POSTGRES_PASSWORD=change-me

# Host port for PostgreSQL.
POSTGRES_HOST_PORT=5432

# --- Backend ---
# Backend HTTP port.
SERVER_PORT=8080

# JWT signing secret (HS256, must be >= 32 bytes). Generate e.g.: openssl rand -hex 48
# CHANGE FOR PROD: must be a long random secret, kept out of version control.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
# Token lifetimes (ms). Access tokens are short-lived and renewed via the
# longer-lived, server-stored refresh token. Defaults: 1h access, 7d refresh.
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Account lockout (optional; defaults shown). After LOCKOUT_MAX_ATTEMPTS failed
# password attempts within LOCKOUT_WINDOW_MINUTES, the account is locked for
# LOCKOUT_DURATION_MINUTES, then auto-unlocks. State is kept in Redis.
# LOCKOUT_MAX_ATTEMPTS=10
# LOCKOUT_DURATION_MINUTES=15
# LOCKOUT_WINDOW_MINUTES=15

# Browser origins allowed to call the API and open the WebSocket (comma-separated).
# Dev default (when unset) is http://localhost:5173. Never use "*".
APP_ALLOWED_ORIGINS=http://localhost:5173

# Image attachments (optional). When set, message image uploads go to Cloudinary;
# leave unset to disable uploads (the app still runs). Format:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Web Push notifications (optional). Generate a key pair with:
#   npx web-push generate-vapid-keys
# Set both keys to enable browser push; leave unset to disable (the app still
# runs). VAPID_SUBJECT is a contact mailto: or URL.
# VAPID_PUBLIC_KEY=<base64url public key>
# VAPID_PRIVATE_KEY=<base64url private key>
# VAPID_SUBJECT=mailto:you@example.com

# GIF search (optional). A Giphy API key enables the GIF picker; leave unset to
# disable it. Get a free key at developers.giphy.com.
# GIPHY_API_KEY=<your giphy api key>

# AI channel summarization (optional). An Anthropic API key enables the
# "✨ Özetle" button; leave unset to disable (the app still runs). Get one at
# console.anthropic.com. AI_MODEL overrides the default model.
# ANTHROPIC_API_KEY=<your anthropic api key>
# AI_MODEL=claude-opus-4-8

# Platform admins (optional). Comma-separated usernames promoted to global admin
# on startup — the bootstrap for the first admin; further grants happen in the
# in-app admin panel. Users must already exist. Leave unset for no admins.
# NOTE: these usernames are re-applied on every boot, so they are effectively
# permanent admins — revoking one in the panel is undone at the next restart.
# To demote a listed user for good, remove them from this variable first.
# ADMIN_USERNAMES=alice,bob

# Email (optional: password reset + email verification). Inactive by default —
# MailService logs the action link to the console so the flows work in dev with
# no mail server. To actually send, set MAIL_ENABLED=true and the SMTP details.
# MAIL_ENABLED=true
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=<smtp user>
# MAIL_PASSWORD=<smtp password>
# MAIL_FROM=no-reply@ripplechat.app
# Base URL the emailed links point at (the frontend). Defaults to the dev server.
# APP_FRONTEND_BASE_URL=http://localhost:5173

# Distributed tracing (optional). traceId/spanId are always added to logs; set a
# sampling rate > 0 and an OTLP endpoint to also export spans to a collector
# (Grafana Tempo / Jaeger / Alloy). Defaults: no sampling (no export, no collector).
# TRACING_SAMPLE_RATE=0.1
# OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Exposed Actuator endpoints (optional). Defaults to health,info,prometheus,metrics.
# prometheus/metrics require authentication but are readable by any authenticated
# user; a hardened deployment can trim this to just health,info.
# MANAGEMENT_EXPOSED_ENDPOINTS=health,info

# =====================================================================
# PRODUCTION (set these in the prod environment; do not commit real values)
# ---------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=prod      # enables validate + Flyway, disables SQL logging
# POSTGRES_PASSWORD=<strong-unique-password>
# JWT_SECRET=<openssl rand -hex 48>
# APP_ALLOWED_ORIGINS=https://your-real-domain.com
# POSTGRES_DB / POSTGRES_USER / POSTGRES_HOST_PORT / SERVER_PORT as appropriate
# (the datasource URL is built from POSTGRES_* — point it at the prod database)
# Note: on first prod deploy the database should be empty so Flyway can apply
# V1__initial_schema.sql; Hibernate then validates the schema against the entities.
# =====================================================================
