# Copy to .env for local development.
#
# Dev: leave these empty/relative — the Vite proxy (vite.config.ts) forwards
# /api and /ws same-origin to the backend on :8081.
#   VITE_API_URL=        (empty -> relative -> proxied)
#   VITE_WS_URL=/ws
#
# Production: the build uses .env.production (committed) or Vercel env vars with
# the deployed backend's absolute URLs, e.g.:
#   VITE_API_URL=https://ripplechat-backend.onrender.com
#   VITE_WS_URL=https://ripplechat-backend.onrender.com/ws   (SockJS upgrades to wss)
VITE_API_URL=
VITE_WS_URL=/ws
