{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile=coverage/vitest-report.json",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:integration": "playwright test --config playwright.integration.config.ts",
    "demo:gif": "playwright test demo-recording && node scripts/encode-gif.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@stomp/stompjs": "^7.5.0",
    "@tiptap/extension-placeholder": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "axios": "^1.21.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5",
    "react-syntax-highlighter": "^16.1.2",
    "react-virtuoso": "^4.18.19",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sockjs-client": "^1.6.1",
    "tiptap-markdown": "^0.9.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/sockjs-client": "^1.5.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gifenc": "1.0.3",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "pngjs": "7.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.8",
    "workbox-precaching": "7.4.1"
  }
