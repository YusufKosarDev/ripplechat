# Production frontend config. These are PUBLIC backend endpoints (not secrets),
# so this file is committed. `vite build` (and Vercel's build) loads it
# automatically in production mode. Edit if the backend URL changes.
# Local dev is unaffected — `npm run dev` uses .env (relative + Vite proxy).
VITE_API_URL=https://ripplechat-backend.onrender.com
# SockJS endpoint over HTTPS — SockJS negotiates the secure WebSocket (wss) itself.
VITE_WS_URL=https://ripplechat-backend.onrender.com/ws
