# Build config for the integration e2e suite (`vite build --mode integration`).
#
# Deliberately relative, so the previewed bundle talks to whatever backend the
# preview server proxies to (localhost:8081 — see `preview.proxy` in
# vite.config.ts) rather than the deployed one named in .env.production. Without
# this the suite would build a bundle pointed at production and quietly test
# that instead, which is exactly what happened the first time it was run.
#
# Relative also keeps the app same-origin, so it runs under the real
# Content-Security-Policy: `connect-src 'self'` covers it with nothing widened.
VITE_API_URL=
VITE_WS_URL=/ws
