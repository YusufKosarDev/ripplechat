root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java and Maven/XML use tab indentation in this repo.
[*.{java,xml}]
indent_style = tab

[*.{properties,env}]
indent_style = space

# Windows batch scripts must keep CRLF.
[*.{bat,cmd}]
end_of_line = crlf
charset = unset

# Markdown keeps trailing whitespace (hard line breaks).
[*.md]
trim_trailing_whitespace = false
